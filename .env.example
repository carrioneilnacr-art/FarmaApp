# ==============================================================================
# FarmaApp - Variables de Entorno de Ejemplo
# Duplica este archivo como .env y coloca tus credenciales de Supabase
# ==============================================================================

# URL pública de la instancia de Supabase (ejemplo: https://xxxxxxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clave pública anónima (Anon / Public Key) para consultas autenticadas mediante RLS
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Entorno de ejecución (development | preview | production)
EXPO_PUBLIC_APP_ENV=development
